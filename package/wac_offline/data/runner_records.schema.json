{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cortac:scratch:records:v1",
  "title": "Synthetic disposable scratch runner records",
  "description": "Structural schema only. Runtime separately resolves evidence and checks issued receipts, mandates, role conflicts, chronology and state. No authentication or external authority.",
  "$defs": {
    "policy": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "cortac.scratch.policy.v1",
          "type": "string"
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "[\\s\\S]*\\S[\\s\\S]*"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "principals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "[\\s\\S]*\\S[\\s\\S]*"
              },
              "controller": {
                "type": "string",
                "minLength": 1,
                "pattern": "[\\s\\S]*\\S[\\s\\S]*"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "affected_party",
                    "approver",
                    "assessor",
                    "auditor",
                    "authorizer",
                    "executor",
                    "proposer",
                    "reviewer"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "controller",
              "roles"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "protected_limits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "[\\s\\S]*\\S[\\s\\S]*"
              },
              "commitment": {
                "type": "string",
                "minLength": 1,
                "pattern": "[\\s\\S]*\\S[\\s\\S]*"
              }
            },
            "required": [
              "id",
              "commitment"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "approval_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "[\\s\\S]*\\S[\\s\\S]*"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "approval_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "excluded_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "[\\s\\S]*\\S[\\s\\S]*"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "operation_budget": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "schema",
        "case_id",
        "epoch",
        "principals",
        "protected_limits",
        "approval_ids",
        "approval_threshold",
        "excluded_ids",
        "operation_budget"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "cortac.scratch.evidence.v1",
          "type": "string"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "[\\s\\S]*\\S[\\s\\S]*"
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "pattern": "[\\s\\S]*\\S[\\s\\S]*"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "pattern": "[\\s\\S]*\\S[\\s\\S]*"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provenance": {
          "const": "SYNTHETIC_FIXTURE",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "id",
        "origin",
        "content",
        "content_digest",
        "provenance"
      ],
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "cortac.scratch.proposal.v1",
          "type": "string"
        },
        "case_id": {
