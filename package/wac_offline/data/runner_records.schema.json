                    "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                  },
                  "review_authority": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                  }
                },
                "required": [
                  "condition",
                  "review_authority"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "remedy_plan": {
              "type": "object",
              "properties": {
                "authority": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                },
                "resources": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                },
                "steps": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "authority",
                "resources",
                "steps",
                "evidence_refs"
              ],
              "additionalProperties": false
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "[\\s\\S]*\\S[\\s\\S]*"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "schema",
            "affected_parties",
            "alternatives",
            "protected_limit_assessments",
            "burden_justification",
            "dissent",
            "dissent_status",
            "predictions",
            "review_triggers",
            "remedy_plan",
            "evidence_refs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema",
        "case_id",
        "policy_digest",
        "epoch",
        "expected_revision",
        "operation",
        "target",
        "value",
        "proposer",
        "evidence",
        "decision_source",
        "decision_record"
      ],
      "additionalProperties": false
    },
    "mandate": {
      "type": "object",
      "properties": {
        "schema": {
