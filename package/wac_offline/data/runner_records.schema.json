          "pattern": "[\\s\\S]*\\S[\\s\\S]*"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
