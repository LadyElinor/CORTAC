          "minimum": 0
        },
        "operation": {
          "type": "string",
          "enum": [
            "COMMIT",
            "REPAIR"
          ]
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "ASSESSMENT",
            "APPROVAL",
            "AUTHORIZATION",
            "REVIEW"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "pattern": "[\\s\\S]*\\S[\\s\\S]*"
        },
        "challenge_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "const": "NONE",
              "type": "string"
            }
          ]
        },
        "result": {
          "const": "PASS",
          "type": "string"
        },
        "scope": {
          "const": "SYNTHETIC_SCRATCH_ONLY",
          "type": "string"
        },
        "provenance": {
          "const": "SYNTHETIC_FIXTURE",
          "type": "string"
