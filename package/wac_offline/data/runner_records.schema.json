        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "operation": {
          "type": "string",
          "enum": [
            "COMMIT",
            "REPAIR"
          ]
        },
        "target": {
          "const": "scratch_document",
          "type": "string"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "[\\s\\S]*\\S[\\s\\S]*"
        },
        "proposer": {
          "type": "string",
          "minLength": 1,
          "pattern": "[\\s\\S]*\\S[\\s\\S]*"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "[\\s\\S]*\\S[\\s\\S]*"
              },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "digest"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "decision_source": {
          "type": "string",
          "minLength": 1,
          "pattern": "[\\s\\S]*\\S[\\s\\S]*"
        },
        "decision_record": {
          "type": "object",
          "properties": {
            "schema": {
              "type": "string",
              "const": "cortac.decision.record.v1"
            },
            "affected_parties": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                  },
                  "interests": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                  },
                  "benefits": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                  },
                  "burdens": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                  },
                  "representation": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                  }
                },
                "required": [
                  "id",
                  "interests",
                  "benefits",
                  "burdens",
                  "representation"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "option": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                  },
                  "less_harmful_analysis": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                  },
                  "rejection_or_selection_reason": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "option",
                  "less_harmful_analysis",
                  "rejection_or_selection_reason",
                  "evidence_refs"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "protected_limit_assessments": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "limit_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "PASS",
                      "FAIL",
                      "UNKNOWN"
                    ]
                  },
                  "reasons": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "required": [
                  "limit_id",
                  "status",
                  "reasons",
                  "evidence_refs"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "burden_justification": {
              "type": "string",
              "minLength": 1,
              "pattern": "[\\s\\S]*\\S[\\s\\S]*"
            },
            "dissent": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "[\\s\\S]*\\S[\\s\\S]*"
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "dissent_status": {
              "type": "string",
              "enum": [
                "NONE_REPORTED",
                "RECORDED"
              ]
            },
            "predictions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "[\\s\\S]*\\S[\\s\\S]*"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "review_triggers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "condition": {
                    "type": "string",
