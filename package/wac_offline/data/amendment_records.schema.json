        "remedy": {
          "type": "string",
          "enum": [
            "REPLACE_REGISTRATION",
            "REPAIR_INVALIDATION"
          ]
        },
        "remedy_authorized": {
          "type": "boolean",
          "const": true
        },
        "external_principals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "resource_units": {
          "type": "integer",
          "minimum": 1
