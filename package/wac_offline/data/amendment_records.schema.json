          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "registrar": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "issued_at": {
          "type": "integer",
          "minimum": 0
        },
        "deadline": {
          "type": "integer",
          "minimum": 0
        },
        "appeal_authorities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "replacement_authorities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "authority": {
          "type": "string",
          "const": "NONE"
        },
        "execution_enabled": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "schema",
        "proposal_digest",
        "registrar",
        "reason",
        "evidence_refs",
        "issued_at",
        "deadline",
        "appeal_authorities",
        "replacement_authorities",
        "authority",
        "execution_enabled"
      ],
      "additionalProperties": false
    },
    "ChallengeUpdate": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
