    "ResourceRemedyGrant": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "cortac.amendment.resource-remedy-grant.v2"
        },
        "grant_id": {
          "type": "string",
          "minLength": 1
        },
        "complaint_digest": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "source_digest": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "repair_proposal_digest": {
          "type": "string",
          "pattern": "[0-9a-f]{64}"
        },
        "old_policy_digest": {
          "type": "string",
