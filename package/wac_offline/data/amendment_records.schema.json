        },
        "expected_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "issued_at": {
          "type": "integer",
          "minimum": 0
        },
        "authority": {
          "type": "string",
          "const": "NONE"
        },
        "execution_enabled": {
          "type": "boolean",
