        "disposition": {
          "type": "string",
          "enum": [
            "OPEN",
            "RESOLVED",
            "STAY",
            "ESCALATION_REQUIRED"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "issued_at": {
          "type": "integer",
          "minimum": 0
        },
        "authority": {
          "type": "string",
          "const": "NONE"
        },
        "execution_enabled": {
          "type": "boolean",
          "const": false
        },
        "deadline": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "schema",
        "registration_digest",
        "challenge_id",
        "disposition",
        "actor",
        "reason",
        "evidence_refs",
        "issued_at",
        "authority",
        "execution_enabled",
        "deadline",
        "revision"
      ],
      "additionalProperties": false
    },
    "Invalidation": {
      "type": "object",
